# Firebird
FB_HOST=
FB_PORT=
FB_DATABASE=
FB_USER=
FB_PASSWORD=
# Opcionais: charset da conexão (padrão UTF8; use WIN1252 se os acentos vierem errados)
# e caminho do fbclient.dll (só se o app não achar sozinho o cliente do Firebird)
FB_CHARSET=
FB_CLIENT_LIBRARY=

# Magazord API
# BASE_URL é o domínio da loja, sem /api (ex: https://minhaloja.painel.magazord.com.br)
# DEPOSITO e TABELA_PRECO são os IDs numéricos do depósito e da tabela de preço no Magazord
MAGAZORD_BASE_URL=
MAGAZORD_TOKEN=
MAGAZORD_SENHA=
MAGAZORD_DEPOSITO=
MAGAZORD_TABELA_PRECO=

# E-mail (notificação de erros)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINO=
